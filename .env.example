# ---- LLM (any OpenAI-compatible endpoint). Leave LLM_API_KEY empty to run in offline mode. ----

# Groq (free key: https://console.groq.com/keys). Use openai/gpt-oss-20b if you want it faster.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_REASONING_EFFORT=low

# Google Gemini (free key: https://aistudio.google.com/apikey)
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.5-flash
# LLM_REASONING_EFFORT=low

# OpenAI (remove LLM_REASONING_EFFORT for non-reasoning models like gpt-4o-mini)
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# Local Ollama (no key needed)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1

# ---- Optional: live job listings from Adzuna (https://developer.adzuna.com) ----
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in

PORT=8000
